{
  "name": "dv-ai-agent",
  "version": "1.0.0",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pkg:win": "pkg . --targets node16-win-x64 --output dist/dv-ai-agent.exe",
    "pkg:linux": "pkg . --targets node16-linuxstatic-x64 --output dist/dv-ai-agent",
    "pkg:all": "pkg . --targets node16-win-x64,node16-linuxstatic-x64 --output dist/dv-ai-agent"
  },
  "keywords": ["ai", "agent", "ic-verification"],
  "dependencies": {
    "dotenv": "^16.4.5",
    "xlsx": "^0.18.5",
    "mammoth": "^1.7.2",
    "axios": "^1.7.2",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "pkg": {
    "scripts": ["dist/**/*.js"],
    "assets": [],
    "targets": [
      "node16-win-x64",
      "node16-linuxstatic-x64"
    ]
  }
}
